{
  "metadata": {
    "name": "m-run-1",
    "namespace": "ns",
    "labels": {
      "app.kubernetes.io/managed-by": "pgcopydb-operator",
      "pgcopydb-operator.io/migration": "m"
    }
  },
  "spec": {
    "backoffLimit": 0,
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "pgcopydb-operator",
          "pgcopydb-operator.io/migration": "m"
        }
      },
      "spec": {
        "volumes": [
          {
            "name": "workdir",
            "persistentVolumeClaim": {
              "claimName": "m-work"
            }
          },
          {
            "name": "tmp",
            "emptyDir": {}
          },
          {
            "name": "source-password",
            "secret": {
              "secretName": "sec",
              "items": [
                {
                  "key": "password",
                  "path": "source-password"
                }
              ],
              "defaultMode": 256
            }
          }
        ],
        "containers": [
          {
            "name": "pgcopydb",
            "image": "img",
            "command": [
              "/bin/sh",
              "-c",
              "set -eu\numask 077\n: \u003e /tmp/pgpass\nprintf '%s:*:*:%s:%s\\n' 's' 'u' \"$(sed -e 's/\\\\/\\\\\\\\/g' -e 's/:/\\\\:/g' /etc/pgcopydb/creds/source-mnt/source-password)\" \u003e\u003e /tmp/pgpass\nexport PGPASSFILE=/tmp/pgpass\nexec \"$0\" \"$@\"",
              "pgcopydb"
            ],
            "args": [
              "clone",
              "--dir",
              "/work/pgcopydb",
              "--table-jobs",
              "4",
              "--split-tables-larger-than",
              "536870912",
              "--split-max-parts",
              "8",
              "--use-copy-binary",
              "--restart"
            ],
            "env": [
              {
                "name": "PGCOPYDB_SOURCE_PGURI",
                "value": "postgresql://u@s:5432/d?keepalives=1\u0026keepalives_idle=10\u0026keepalives_interval=10\u0026keepalives_count=6\u0026tcp_user_timeout=60000"
              },
              {
                "name": "PGCOPYDB_TARGET_PGURI",
                "value": "postgresql://u@t:5432/d?keepalives=1\u0026keepalives_idle=10\u0026keepalives_interval=10\u0026keepalives_count=6"
              },
              {
                "name": "PGCOPYDB_LOG_JSON",
                "value": "on"
              },
              {
                "name": "PGPASSFILE",
                "value": "/tmp/pgpass"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "4",
                "memory": "4Gi"
              }
            },
            "volumeMounts": [
              {
                "name": "workdir",
                "mountPath": "/work"
              },
              {
                "name": "tmp",
                "mountPath": "/tmp"
              },
              {
                "name": "source-password",
                "readOnly": true,
                "mountPath": "/etc/pgcopydb/creds/source-mnt"
              }
            ],
            "securityContext": {
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "readOnlyRootFilesystem": true,
              "allowPrivilegeEscalation": false
            }
          }
        ],
        "restartPolicy": "Never",
        "securityContext": {
          "runAsUser": 65532,
          "runAsGroup": 65532,
          "runAsNonRoot": true,
          "fsGroup": 65532,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        }
      }
    }
  },
  "status": {}
}
