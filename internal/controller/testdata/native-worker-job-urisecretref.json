{
  "metadata": {
    "name": "migration-run-1",
    "namespace": "namespace",
    "labels": {
      "app.kubernetes.io/managed-by": "pgcopydb-operator",
      "pgcopydb-operator.io/feature-e2e-run": "run-owner",
      "pgcopydb-operator.io/migration": "migration"
    }
  },
  "spec": {
    "backoffLimit": 0,
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "pgcopydb-operator",
          "pgcopydb-operator.io/feature-e2e-run": "run-owner",
          "pgcopydb-operator.io/migration": "migration"
        }
      },
      "spec": {
        "volumes": [
          {
            "name": "workdir",
            "persistentVolumeClaim": {
              "claimName": "migration-work"
            }
          },
          {
            "name": "tmp",
            "emptyDir": {}
          },
          {
            "name": "source-password",
            "secret": {
              "secretName": "sec",
              "items": [
                {
                  "key": "password",
                  "path": "source-password"
                }
              ],
              "defaultMode": 256
            }
          }
        ],
        "containers": [
          {
            "name": "pgcopydb",
            "image": "registry.example/native@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "command": [
              "/bin/sh",
              "-c",
              "set -eu\numask 077\n: \u003e /tmp/pgpass\nprintf '%s:5432:*:%s:%s\\n' 's' 'u' \"$(sed -e 's/\\\\/\\\\\\\\/g' -e 's/:/\\\\:/g' /etc/pgcopydb/creds/source-mnt/source-password)\" \u003e\u003e /tmp/pgpass\nexport PGPASSFILE=/tmp/pgpass\nexec \"$0\" \"$@\"",
              "/usr/local/bin/rpgmigrate"
            ],
            "args": [
              "clone",
              "--dir",
              "/work/pgcopydb",
              "--table-jobs",
              "4",
              "--skip-large-objects",
              "--restart",
              "--follow",
              "--plugin",
              "pgoutput"
            ],
            "env": [
              {
                "name": "PGCOPYDB_SOURCE_PGURI",
                "value": "postgresql://u@s:5432/d?keepalives=1\u0026keepalives_idle=10\u0026keepalives_interval=10\u0026keepalives_count=6\u0026tcp_user_timeout=60000"
              },
              {
                "name": "PGCOPYDB_TARGET_PGURI",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "tgt-dsn",
                    "key": "dsn-uri"
                  }
                }
              },
              {
                "name": "PGCOPYDB_LOG_JSON",
                "value": "on"
              },
              {
                "name": "PGPASSFILE",
                "value": "/tmp/pgpass"
              },
              {
                "name": "RPGMIGRATE_MIGRATION_UID",
                "value": "01234567-89ab-cdef-0123-456789abcdef"
              },
              {
                "name": "RPGMIGRATE_RUN_ID",
                "value": "0123456789abcdef0123456789abcdef"
              },
              {
                "name": "RPGMIGRATE_WORKDIR_ID",
                "value": "pvc-owned"
              },
              {
                "name": "RPGMIGRATE_CHECKPOINT_GENERATION",
                "value": "1"
              },
              {
                "name": "LC_ALL",
                "value": "C"
              },
              {
                "name": "LANG",
                "value": "C"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "4",
                "memory": "4Gi"
              }
            },
            "volumeMounts": [
              {
                "name": "workdir",
                "mountPath": "/work"
              },
              {
                "name": "tmp",
                "mountPath": "/tmp"
              },
              {
                "name": "source-password",
                "readOnly": true,
                "mountPath": "/etc/pgcopydb/creds/source-mnt"
              }
            ],
            "securityContext": {
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "readOnlyRootFilesystem": true,
              "allowPrivilegeEscalation": false
            }
          }
        ],
        "restartPolicy": "Never",
        "dnsPolicy": "ClusterFirst",
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsUser": 65532,
          "runAsGroup": 65532,
          "runAsNonRoot": true,
          "fsGroup": 65532,
          "fsGroupChangePolicy": "OnRootMismatch",
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        }
      }
    }
  },
  "status": {}
}
