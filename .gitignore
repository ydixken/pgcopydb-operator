# Kubebuilder set (kept in union with the scaffold's generated .gitignore).
bin/
Dockerfile.cross
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
go.work.sum
!vendor/**/zz_generated.*

# Editors
.idea
.vscode
*.swp
*.swo
*~

# macOS host
.DS_Store

# Local cluster credentials are secrets and MUST never be committed.
kubeconfig/
*.kubeconfig

# Local secrets
.env

# Per-user agent settings (the vendored .claude/skills/ stays tracked)
.claude/settings.local.json

# Agent worktrees are transient workspaces, never repo content.
.claude/worktrees/

# mkdocs build output (mkdocs.yml), served by GitHub Pages, never committed.
site/
